# ==========================
# posihub backend env example
# ==========================

# Application
APP_NAME=posihub
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# Database (SQLite by default, switch to postgresql+psycopg later)
DATABASE_URL=sqlite:///./posihub.db

# Encryption key used to encrypt API keys at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POSIHUB_ENCRYPTION_KEY=

# Scheduler
SYNC_INTERVAL_MINUTES=5
DAILY_SNAPSHOT_TIME=23:55

# CORS (comma separated origins)
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
